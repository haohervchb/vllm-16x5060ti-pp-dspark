#!/bin/sh
set -e

cat <<'EOF'
menuentry 'RTX 5060 Ti ReBAR 16 GiB (one boot)' --id rebar-preboot {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp @ESP_UUID@
    chainloader ($esp)/EFI/sglang/ReBarPreboot.efi
    boot

    insmod ext2
    search --no-floppy --file --set=root /boot/grub/grub.cfg
    configfile /boot/grub/grub.cfg
}

menuentry 'RTX 5060 Ti ReBAR 16 GiB (automatic)' --id rebar-preboot-auto {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp @ESP_UUID@
    chainloader ($esp)/EFI/sglang/ReBarPrebootAuto.efi
    boot

    # GRUB consumed next_entry before entering here. Reloading grub.cfg now
    # selects the normal default rather than entering this one-shot again.
    insmod ext2
    search --no-floppy --file --set=root /boot/grub/grub.cfg
    configfile /boot/grub/grub.cfg
}
EOF
