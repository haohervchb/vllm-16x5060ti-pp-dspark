#!/bin/sh
set -e

cat <<'EOF'
menuentry 'RTX 5060 Ti ReBAR 16 GiB (automatic)' --id rebar-preboot-auto {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp @ESP_UUID@
    chainloader ($esp)/EFI/sglang/ReBarPrebootAuto.efi
    boot

    # The automatic EFI application returns here after applying BAR1. Make
    # absolutely sure no stale ReBAR selection can recurse, then reload the
    # normal Ubuntu GRUB configuration. This script is installed as 41_*, so
    # ordinary Linux entries are generated before this helper.
    if [ "${saved_entry}" = "rebar-preboot" -o \
         "${saved_entry}" = "rebar-preboot-auto" ]; then
        set saved_entry=
        save_env saved_entry
    fi
    set next_entry=
    save_env next_entry
    set default=0

    insmod ext2
    search --no-floppy --file --set=root /boot/grub/grub.cfg
    configfile /boot/grub/grub.cfg
}
EOF
