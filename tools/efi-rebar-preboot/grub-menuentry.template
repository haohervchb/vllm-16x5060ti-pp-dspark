#!/bin/sh
set -e

cat <<'EOF'
menuentry 'RTX 5060 Ti ReBAR 16 GiB (one boot)' --id rebar-preboot {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp @ESP_UUID@
    chainloader ($esp)/EFI/sglang/ReBarPreboot.efi
    boot

    # Never recursively reload grub.cfg here. A saved/default ReBAR entry can
    # otherwise select this same EFI application again and trap the machine in
    # the interactive "Press uppercase A" screen. Return to GRUB's caller/menu.
}

menuentry 'RTX 5060 Ti ReBAR 16 GiB (automatic)' --id rebar-preboot-auto {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp @ESP_UUID@
    chainloader ($esp)/EFI/sglang/ReBarPrebootAuto.efi
    boot

    # The EFI application returns to GRUB. Do not configfile grub.cfg from
    # inside this entry: saved_entry/next_entry state can otherwise recurse
    # into a ReBAR entry instead of continuing to Ubuntu.
}
EOF
